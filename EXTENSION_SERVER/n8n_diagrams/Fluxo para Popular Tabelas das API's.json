    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH expected(system, endpoint) AS (\n  {{ (() => {\n    const items = $('Split Endpoints').all();\n    if (!items || items.length === 0) {\n      return \"SELECT NULL::text AS system, NULL::text AS endpoint WHERE FALSE\";\n    }\n\n    const values = items\n      .map((item) => {\n        const system = String(item.json?.system || '').replace(/'/g, \"''\");\n        const endpoint = String(item.json?.url || '').replace(/'/g, \"''\");\n        return `('${system}', '${endpoint}')`;\n      })\n      .join(',\\n    ');\n\n    return `VALUES\\n    ${values}`;\n  })() }}\n), status_by_endpoint AS (\n  SELECT\n    e.system,\n    e.endpoint,\n    w.status\n  FROM expected e\n  LEFT JOIN auxiliary.workflow_task_control w\n    ON w.system = e.system\n   AND w.endpoint = e.endpoint\n)\nSELECT\n  COUNT(*)::int AS total_endpoints,\n  COUNT(*) FILTER (WHERE status IN (2, -1))::int AS finished_endpoints\nFROM status_by_endpoint;",
        "options": {
          "connectionTimeout": 30,
          "queryBatching": "single",
          "replaceEmptyStrings": true
        }
      },
