    {
      "parameters": {
        "jsCode": "const input = $json || {};\nconst allEndpoints = Array.isArray(input.endpoints) ? input.endpoints : [];\n\nfunction normalizeSystem(value) {\n  return String(value || '').trim().toLowerCase();\n}\n\nlet systems = [];\nif (Array.isArray(input.systems) && input.systems.length > 0) systems = input.systems.map(normalizeSystem);\nelse if (input.system) systems = [normalizeSystem(input.system)];\nelse systems = ['vhsys', 'clockify', 'clockify_report', 'glpi'];\n\nconst systemSet = new Set(systems);\nlet filtered = allEndpoints.filter((e) => systemSet.has(String(e.system || '').toLowerCase()));\n\nif (input.url) filtered = filtered.filter((e) => String(e.url) === String(input.url));\nif (input.table) filtered = filtered.filter((e) => String(e.table) === String(input.table));\n\nreturn [{ json: { endpoints: filtered, request: input } }];"
      },
