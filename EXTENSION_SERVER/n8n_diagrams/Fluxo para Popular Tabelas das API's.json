        "postgres": {
          "id": "tnATsHmPQ4uK6XL9",
          "name": "Dev Database"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const results = Array.isArray($json.results) ? $json.results : [];\nconst errors = results.filter((r) => r && r.status === 'error');\n\nif (errors.length > 0) {\n  return [{\n    json: {\n      status: 'error',\n      total_endpoints: results.length,\n      total_success: 0,\n      total_errors: errors.length,\n      errors,\n      results: errors\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    status: 'success',\n    total_endpoints: results.length,\n    total_success: results.length,\n    total_errors: 0,\n    errors: [],\n    results\n  }\n}];"
      },
