    {
      "parameters": {
        "jsCode": "// Erro de leitura do banco\nconst errData = $input.first().json;\nconst dbMessage = errData.message || errData.error || 'Unknown DB error';\n\nconsole.log(JSON.stringify({\n  timestamp: new Date().toISOString(),\n  route: 'nf_service_labels_ids',\n  event: 'db_read_error',\n  message: dbMessage,\n  level: 'error'\n}));\n\nreturn {\n  statusCode: 500,\n  body: { ok: false, error: 'Database read error', message: dbMessage }\n};"
      },
      "id": "dd28b764-4048-48f5-96ba-2ecac39ab82f",
      "name": "Montar Resposta de Erro de Banco",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2048,
        1392
      ]
    },
    {
      "parameters": {
        "jsCode": "const allRecords = $input.all();\n\nconst labels = allRecords\n  .map(item => item.json || {})\n  .filter(row => row.codigo)\n  .map(row => ({\n    codigo: row.codigo || '',\n    numeronfs: row.numeronfs || ''\n  }));\n\nconsole.log(JSON.stringify({\n  timestamp: new Date().toISOString(),\n  route: 'nf_service_labels_ids',\n  event: 'labels_read',\n  total_input_items: allRecords.length,\n  total_output_items: labels.length,\n  level: 'info'\n}));\n\nreturn {\n  statusCode: 200,\n  body: {\n    status: 'Manager status id',\n    data: labels\n  }\n};"
      },
      "id": "4ebd0573-bc8d-463a-88b4-af96814e4090",
      "name": "Formatar Lista de Labels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2048,
        1232
      ]
