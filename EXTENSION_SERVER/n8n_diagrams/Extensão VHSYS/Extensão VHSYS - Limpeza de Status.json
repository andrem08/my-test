        "query": "\nUPDATE auxiliary.status_processamento_cc\nSET\n  \"status_entradas\"  = 0,\n  \"status_saidas\" = 0\nWHERE \n\t\"status_entradas\" != 0 OR \"status_saidas\" != 0\nRETURNING \"cc_id\", \"status_entradas\", \"status_saidas\";",
        "options": {
          "connectionTimeout": 30,
